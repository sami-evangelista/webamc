\usetikzlibrary{shapes}

%  #1 = eloignement du label
%  #2 = style/position du noeud
%  #3 = nom du noeud
%  #4 = angle du label
%  #5 = label
%  #6 = echelle de l'element
%  #7 = fichier d'image de l'element
\newcommand\elementReseau[7][1]{%
  \node[#2] (#3) {\includegraphics[scale=#6]{#7}};%
  \@ifmtarg{#4}{%
  }{%
    \pgfmathparse{#1 * (cos(#4) * 28.34) / 1.85}\let\x\pgfmathresult%
    \pgfmathparse{#1 * (sin(#4) * 28.34) / 1.85}\let\y\pgfmathresult%
    \node[
      above of=#3,%
      node distance={\y}%
    ] (#3-lbl) {};%
    \node[%
      right of=#3-lbl,%
      node distance={\x},%
      align=center%
    ] (#3-lbl) {\scriptsize #5};%
  }%
}
\newcommand\machine[4]{%
